# 실제 값은 .env.local(또는 .env)에 — git 미추적. 발급 절차: tasks.md T0
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# NCP NAVER API HUB 검색 API 키쌍 (X-NCP-APIGW-API-KEY-ID / X-NCP-APIGW-API-KEY)
# 서버 전용 — NEXT_PUBLIC_ 접두사 금지. 개발자센터 검색 API는 신규 등록 불가 (decision-log #19)
NAVER_SEARCH_CLIENT_ID=
NAVER_SEARCH_CLIENT_SECRET=
# NCP 콘솔 Maps — Client ID 는 지도 렌더링용이라 브라우저 노출 가능,
# Client Secret 은 길찾기(Directions 15) 서버 호출용이라 서버 전용 (결정 #45)
NEXT_PUBLIC_NCP_MAP_CLIENT_ID=
NCP_MAP_CLIENT_SECRET=
# 카카오 로그인 (결정 #33) — 카카오 개발자 콘솔에서:
#   REST API 키   = 앱 설정 > 앱 키
#   Client Secret = 제품 설정 > 카카오 로그인 > 보안 (생성 + '사용함')
# Supabase 가 읽는다(supabase/config.toml). 서버 전용 — NEXT_PUBLIC_ 접두사 금지
KAKAO_REST_API_KEY=
KAKAO_CLIENT_SECRET=
